FROM node:22-bullseye-slim AS base

ARG PNPM_VERSION=9.0.0
WORKDIR /app

# Install OS deps required by native modules / Prisma / OpenSSL
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    build-essential python3 make ca-certificates curl git libssl-dev procps \
  && rm -rf /var/lib/apt/lists/*

# Install pnpm
RUN npm install -g pnpm@${PNPM_VERSION}

# Copy root package manifests first for efficient caching
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

# Copy only what's needed for the worker workspace so install is faster
COPY apps/worker ./apps/worker
COPY packages/core/extractor ./packages/core/extractor
COPY packages/core/validation ./packages/core/validation
COPY packages/core/apply ./packages/core/apply
COPY packages/db ./packages/db
COPY packages/utils ./packages/utils
COPY packages/types ./packages/types
COPY packages/config ./packages/config
COPY packages/queue ./packages/queue
COPY packages/typescript-config ./packages/typescript-config
COPY packages/eslint-config ./packages/eslint-config

# Install dependencies (uses pnpm workspace layout)
RUN pnpm install --frozen-lockfile

# Build only the packages needed at runtime
RUN pnpm --filter @applyai/db build
RUN pnpm --filter @applyai/utils build

# Set production env by default (override with docker-compose env if needed)
ENV NODE_ENV=production

# Default command (development mode by name in workspace)
CMD ["pnpm", "--filter", "worker", "run", "dev"]