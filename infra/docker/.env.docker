# Docker environment template. Copy this file to .env and fill every secret.
# Do not commit the resulting .env file.

NODE_ENV=production
API_PORT=3000
API_HOST_PORT=3000

# Vercel frontend URL. Add preview domains as a comma-separated list if needed.
FRONTEND_URL=https://your-project.vercel.app
PUBLIC_API_URL=https://api.your-domain.example

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Security & encryption
COOKIE_ENCRYPTION_KEY=generate-a-64-character-hex-key

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare R2 storage
R2_ENDPOINT_URL=https://your-account.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=applyai-files
R2_PUBLIC_URL=https://your-public-r2-url

# Google Calendar OAuth (optional unless calendar integration is enabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.your-domain.example/api/google-calendar/callback

# Optional: a comma-separated list of user IDs permitted to run admin jobs
ADMIN_USER_IDS=
