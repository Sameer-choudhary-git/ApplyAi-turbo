# ApplyAI Environment Configuration Example
# Copy this file to .env and fill in your actual values

NODE_ENV=development

# DATABASE (Supabase PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/database

# REDIS Configuration
# Option 1: Use REDIS_URL directly (recommended for production)
REDIS_URL=redis://13.204.87.62:6379

# Option 2: Use REDIS_HOST and REDIS_PORT (for development)
REDIS_HOST=redis
REDIS_PORT=6379

# SECURITY & ENCRYPTION
COOKIE_ENCRYPTION_KEY=your-cookie-encryption-key-here

# SUPABASE
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# ERROR TRACKING & MONITORING
# Sentry configuration for error tracking across all services
SENTRY_DSN=https://your-sentry-key@sentry.io/your-project-id

# Error tracking options
ERROR_TRACKING_ENABLED=true
ERROR_TRACKING_ENVIRONMENT=development
ERROR_TRACKING_TRACES_SAMPLE_RATE=1.0
ERROR_TRACKING_PROFILES_SAMPLE_RATE=1.0

# R2 CLOUDFLARE STORAGE
R2_ENDPOINT_URL=https://your-r2-endpoint.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=https://your-r2-public-url

# FRONTEND
FRONTEND_URL=http://localhost:5173

# PUBLIC API
PUBLIC_API_URL=http://localhost:3000

# GOOGLE OAUTH
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google-calendar/callback


# GREENHOUSE FORM AUTOMATION
# Autofill uses Playwright against the company-hosted public Greenhouse form.
GREENHOUSE_AUTO_SUBMIT=false
# Optional OpenAI-compatible server-side answer drafting. If unset, unresolved fields become action_required.
LLM_API_URL=https://api.openai.com/v1
LLM_API_KEY=your-server-side-llm-key
LLM_MODEL=gpt-5-mini
