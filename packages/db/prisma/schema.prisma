generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Scraped data ───────────────────────────────────────────────────────────

model unstop_internships {
  id         String  @id @default(cuid())
  title      String
  company    String
  link       String  @unique
  stipend    String?
  experience String?
  type       String? // "Full Time" | "Part Time"
  location   String?
  skills     Json    @default("[]")
  tags       Json    @default("[]")
  postedDate String?
  daysLeft   String?

  isActive  Boolean   @default(true)
  expiresAt DateTime?

  scrapedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  metadata Json?
}

// ─── Users ──────────────────────────────────────────────────────────────────

model users {
  id String @id

  fullName    String
  email       String  @unique
  phone       String?
  location    String?
  bio         String?
  resumeUrl   String?
  linkedinUrl String?
  githubUrl   String?

  isOnboarded Boolean   @default(false)
  onboardedAt DateTime?

  // Relations
  education                user_education[]
  experience               user_experience[]
  skills                   user_skills[]
  preferences              user_preferences?
  platformSessions         user_platform_sessions[]
  jobApplications          user_job_applications[]
  networkingContacts       user_networking_contacts[]
  savedJobs                user_saved_jobs[]
  entitlements             user_entitlements[]
  subscriptionRedemptions  subscription_redemptions[]
  createdSubscriptionCodes subscription_access_codes[] @relation("subscriptionCodeCreator")
  jobSkillRuns             job_skill_runs[]
  jobSkillSchedules        job_skill_schedules[]
  jobSkillOpportunities    job_skill_opportunities[]
  jobSkillArtifacts        job_skill_artifacts[]

  // ── Job-enable flags ────────────────────────────────────────────────────
  // One boolean per flag in enableJobsConfig.
  // Add a new flag here whenever you add one to the config.
  isUnstopInternshipEnabled Boolean @default(false)
  isUnstopJobEnabled        Boolean @default(false) // was missing — now added
  isCommudleEventEnabled    Boolean @default(false)
  isLinkedinEnabled         Boolean @default(false)

  // Scheduling
  lastQueuedAt    DateTime?
  queueCountToday Int       @default(0)
  lastQueueReset  DateTime?

  // Tasks
  tasks          user_tasks[]
  interviews     user_interviews[]
  googleCalendar user_google_calendar?
  reminders      user_reminders[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Profile sub-tables ─────────────────────────────────────────────────────

model user_education {
  id     String @id @default(cuid())
  userId String
  user   users  @relation(fields: [userId], references: [id], onDelete: Cascade)

  institution  String
  degree       String?
  fieldOfStudy String?
  gpa          String?
  startYear    Int?
  endYear      Int?

  createdAt DateTime @default(now())
}

model user_experience {
  id     String @id @default(cuid())
  userId String
  user   users  @relation(fields: [userId], references: [id], onDelete: Cascade)

  company     String
  role        String?
  duration    String?
  description String?

  createdAt DateTime @default(now())
}

model user_skills {
  id     String @id @default(cuid())
  userId String
  user   users  @relation(fields: [userId], references: [id], onDelete: Cascade)

  skill String

  @@unique([userId, skill])
}

model user_preferences {
  id     String @id @default(cuid())
  userId String @unique
  user   users  @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ── Platform targeting ──────────────────────────────────────────────────
  workModes        Json @default("[]") // ["Remote", "Hybrid", "On-site"]
  opportunityTypes Json @default("[]") // ["Internship", "Full-time Job", ...]
  platforms        Json @default("[]") // ["LinkedIn", "Unstop", ...]

  // ── Location & compensation ─────────────────────────────────────────────
  preferredLocations Json @default("[]") // ["Bangalore", "Remote", ...]
  minStipend         Int  @default(0) // monthly in INR

  // ── Role keywords ───────────────────────────────────────────────────────
  rolesOfInterest Json @default("[]") // ["Frontend Developer", ...]
  industries      Json @default("[]") // ["Technology", "Fintech", ...]

  // ── Automation ───────────────────────────────────────────────────────────
  autoApply       Boolean @default(false)
  dailyApplyLimit Int     @default(10)

  // ── Platform-specific settings (stored as JSONB blobs) ────────────────────
  // Shape for unstopPreferences:
  //   { competition_types: string[], prize_minimum: number }
  unstopPreferences   Json?
  commudlePreferences Json? // ✅ ADD THIS

  // Add more platform-specific blobs as needed:
  // commudlePreferences Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Platform sessions (cookies) ────────────────────────────────────────────

model user_platform_sessions {
  id     String @id @default(cuid())
  userId String
  user   users  @relation(fields: [userId], references: [id], onDelete: Cascade)

  platform        String // "unstop", "commudle", "linkedin", etc.
  encryptedCookie String @db.Text

  isActive       Boolean   @default(true)
  lastVerifiedAt DateTime?
  expiresAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, platform])
}

// ─── Setup tokens ───────────────────────────────────────────────────────────

model unstop_setup_tokens {
  id        String   @id @default(cuid())
  userId    String   @unique
  token     String   @unique
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ─── Job applications ────────────────────────────────────────────────────────

model user_job_applications {
  id String @id @default(cuid())

  userId String
  user   users  @relation(fields: [userId], references: [id], onDelete: Cascade)

  platform String

  jobTitle String
  company  String
  jobLink  String

  status          String
  statusUpdatedAt DateTime @updatedAt

  responseReceivedAt DateTime?
  notes              String?

  type                String? // "job" | "internship" | "hackathon" | "event"
  success_probability Int? // 0–100, agent-assigned
  location            String?

  appliedAt DateTime  @default(now())
  deadline  DateTime?

  interviewScheduled Boolean @default(false)

  interviews      user_interviews[]
  lastInterviewAt DateTime?

  metadata Json?
}

model linkedin_scrape_queue {
  id          String    @id @default(cuid())
  userId      String
  type        String // "FEED_POST" | "JOB" | "CONNECTION" | "NOTIFICATION"
  rawData     Json // structured scraped data
  processed   Boolean   @default(false)
  processedAt DateTime?
  scrapedAt   DateTime  @default(now())

  @@index([userId, processed])
  @@index([userId, type])
}

// ─── Tasks & interviews ───────────────────────────────────────────────────────

model user_tasks {
  id String @id @default(cuid())

  userId String
  user   users  @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  description String?

  priority TaskPriority @default(MEDIUM)
  status   TaskStatus   @default(PENDING)
  category TaskCategory @default(GENERAL)
  source   TaskSource   @default(MANUAL)

  sourceId String?

  dueDate     DateTime?
  completedAt DateTime?

  reminders        task_reminders[]
  googleEventId    String?
  syncedToGoogleAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([dueDate])
}

model user_interviews {
  id String @id @default(cuid())

  userId String
  user   users  @relation(fields: [userId], references: [id], onDelete: Cascade)

  applicationId String?
  application   user_job_applications? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  title   String
  company String
  round   String?

  interviewAt DateTime
  duration    Int?
  meetingUrl  String?
  timezone    String   @default("Asia/Kolkata")

  notes  String?
  status InterviewStatus @default(SCHEDULED)

  googleEventId    String?
  syncedToGoogleAt DateTime?
  reminders        task_reminders[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([interviewAt])
}

model task_reminders {
  id String @id @default(cuid())

  taskId String?
  task   user_tasks? @relation(fields: [taskId], references: [id], onDelete: Cascade)

  interviewId String?
  interview   user_interviews? @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  reminderAt DateTime
  type       ReminderType
  sent       Boolean      @default(false)

  externalId String?

  createdAt DateTime @default(now())

  @@index([reminderAt])
  @@index([sent])
}

model user_google_calendar {
  id String @id @default(cuid())

  userId String @unique
  user   users  @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken  String   @db.Text
  refreshToken String   @db.Text
  expiryDate   DateTime

  email String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Job skill automation ──────────────────────────────────────────────────────

model job_skill_runs {
  id                  String    @id @default(cuid())
  userId              String
  user                users     @relation(fields: [userId], references: [id], onDelete: Cascade)
  triggerType         String    @default("manual")
  status              String    @default("queued")
  idempotencyKey      String
  configurationHash   String
  profileSnapshot     Json      @default("{}")
  preferencesSnapshot Json      @default("{}")
  entitlementSnapshot Json      @default("{}")
  providerCount       Int       @default(0)
  foundCount          Int       @default(0)
  generatedCount      Int       @default(0)
  errorSummary        String?
  startedAt           DateTime?
  completedAt         DateTime?

  opportunities job_skill_opportunities[]
  artifacts     job_skill_artifacts[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([userId, status])
}

model job_skill_schedules {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           users     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled        Boolean   @default(false)
  cronExpression String    @default("30 18 * * *")
  timezone       String    @default("Asia/Kolkata")
  providerKeys   Json      @default("[]")
  roles          Json      @default("[]")
  locations      Json      @default("[]")
  companyTypes   Json      @default("[]")
  seniority      String?
  salaryMin      Int?
  salaryMax      Int?
  maxResults     Int       @default(50)
  materialLimit  Int       @default(10)
  lastRunAt      DateTime?
  nextRunAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, nextRunAt])
}

model job_skill_opportunities {
  id            String          @id @default(cuid())
  userId        String
  user          users           @relation(fields: [userId], references: [id], onDelete: Cascade)
  runId         String?
  run           job_skill_runs? @relation(fields: [runId], references: [id], onDelete: SetNull)
  provider      String
  externalId    String?
  canonicalUrl  String
  sourceUrl     String
  title         String
  company       String
  location      String?
  jobType       String?
  salary        String?
  description   String?
  postedAt      DateTime?
  rawData       Json            @default("{}")
  fitnessScore  Int?
  scoreReason   String?
  status        String          @default("found")
  savedJobId    String?
  applicationId String?

  artifacts job_skill_artifacts[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, canonicalUrl])
  @@index([userId, fitnessScore])
  @@index([userId, status])
  @@index([provider, externalId])
}

model job_skill_artifacts {
  id            String                   @id @default(cuid())
  userId        String
  user          users                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  runId         String
  run           job_skill_runs           @relation(fields: [runId], references: [id], onDelete: Cascade)
  opportunityId String?
  opportunity   job_skill_opportunities? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  kind          String
  status        String                   @default("ready")
  fileName      String
  contentType   String
  storageKey    String?
  publicUrl     String?
  checksum      String?
  errorMessage  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, runId])
  @@index([opportunityId, kind])
}

// ─── Subscription entitlements ────────────────────────────────────────────────

model subscription_tiers {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String?
  features    Json    @default("{}")
  limits      Json    @default("{}")
  isActive    Boolean @default(true)

  accessCodes  subscription_access_codes[]
  entitlements user_entitlements[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model subscription_access_codes {
  id              String             @id @default(cuid())
  tierId          String
  tier            subscription_tiers @relation(fields: [tierId], references: [id])
  codeHash        String             @unique
  codePrefix      String
  maxRedemptions  Int                @default(1)
  redemptionCount Int                @default(0)
  expiresAt       DateTime?
  revokedAt       DateTime?
  note            String?
  createdByUserId String
  createdByUser   users              @relation("subscriptionCodeCreator", fields: [createdByUserId], references: [id])

  redemptions subscription_redemptions[]
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  @@index([tierId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model subscription_redemptions {
  id         String                    @id @default(cuid())
  codeId     String
  code       subscription_access_codes @relation(fields: [codeId], references: [id], onDelete: Cascade)
  userId     String
  user       users                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tierKey    String
  redeemedAt DateTime                  @default(now())

  entitlement user_entitlements?

  @@unique([codeId, userId])
  @@index([userId, redeemedAt])
}

model user_entitlements {
  id                 String                    @id @default(cuid())
  userId             String
  user               users                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tierId             String
  tier               subscription_tiers        @relation(fields: [tierId], references: [id])
  sourceRedemptionId String?                   @unique
  sourceRedemption   subscription_redemptions? @relation(fields: [sourceRedemptionId], references: [id])
  status             String                    @default("active")
  startsAt           DateTime                  @default(now())
  endsAt             DateTime?
  featuresSnapshot   Json                      @default("{}")
  limitsSnapshot     Json                      @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, endsAt])
}

// ─── Saved jobs ───────────────────────────────────────────────────────────────

model user_saved_jobs {
  id     String @id @default(cuid())
  userId String
  user   users  @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  company     String
  url         String?
  location    String?
  workMode    String?
  stipend     String?
  type        String    @default("job")
  sourceSite  String?
  notes       String?
  status      String    @default("saved")
  description String?
  deadline    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, url])
  @@index([userId])
  @@index([userId, status])
}

// ─── Networking ───────────────────────────────────────────────────────────────

model user_networking_contacts {
  id     String @id @default(cuid())
  userId String
  user   users  @relation(fields: [userId], references: [id], onDelete: Cascade)

  name       String
  title      String?
  company    String?
  email      String?
  profileUrl String?
  platform   String  @default("LinkedIn") // LinkedIn | GitHub | Twitter | Email | Unstop | Event | Other
  pinned     Boolean @default(false)

  relationships     Json    @default("[]") // string[] e.g. ["recruiter","peer"]
  status            String  @default("connected") // connected | pending | following | met
  notes             String?
  referralPotential Boolean @default(false)
  tags              Json    @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([userId, pinned])
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum TaskCategory {
  GENERAL
  INTERVIEW
  OA
  DEADLINE
  FOLLOW_UP
}

enum TaskSource {
  MANUAL
  APPLICATION
  AGENT
}

enum ReminderType {
  EMAIL
  GOOGLE_CALENDAR
  PUSH
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

// ─── Reminders / custom schedule events ────────────────────────────────────

model user_reminders {
  id     String @id @default(cuid())
  userId String
  user   users  @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  description String?
  location    String?

  remindAt DateTime //start
  endAt    DateTime? // optional end — if null, treated as a 30-min default duration
  allDay   Boolean   @default(false)

  // What this reminder is "about", if anything
  sourceType String? // "application" | "task" | "interview" | "manual"
  sourceId   String? // FK-ish reference to user_job_applications.id, etc. (no hard FK since sourceType varies)

  status ReminderStatus @default(PENDING)

  // Google Calendar sync
  googleEventId    String?
  syncedToGoogleAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([remindAt])
  @@index([sourceType, sourceId])
}

enum ReminderStatus {
  PENDING
  DONE
  DISMISSED
}
