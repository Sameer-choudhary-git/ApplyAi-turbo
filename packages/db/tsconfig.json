{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../typescript-config/base.json",
  "compilerOptions": {
    "types": [
      "node"
    ],
    "paths": {
      "@applyai/config": [
        "../config/src/index.ts"
      ]
    }
  },
  "include": [
    "*.ts",
    "**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "generated",
    "prisma/generated"
  ]
}
