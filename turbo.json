{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",

  "tasks": {
    "generate": {
      "cache": false
    },

    "build": {
      "dependsOn": [  "^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
        "dist/**",
        "build/**",
        ".next/**",
        "!.next/cache/**",
        "generated/**"
      ]
    },

    "lint": {
      "outputs": []
    },

    "check-types": {
      "dependsOn": ["^check-types"],
      "outputs": []
    },

    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },

    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}