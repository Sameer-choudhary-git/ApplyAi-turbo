# API Server Configuration
PORT=3000
NODE_ENV=development

# Comma-separated Vercel URLs allowed by CORS.
FRONTEND_URL=http://localhost:5173

# Database Configuration
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Redis. Set REDIS_URL in Docker, or use host/port for local development.
REDIS_URL=
REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# R2/Cloudflare Storage Configuration
R2_ENDPOINT_URL=https://your-account.r2.cloudflarecontent.com
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=your-bucket
R2_PUBLIC_URL=https://your-public-url

# Encryption Configuration
COOKIE_ENCRYPTION_KEY=generate-a-64-character-hex-key

# Google Calendar OAuth (optional unless calendar integration is enabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google-calendar/callback

# Public API URL
PUBLIC_API_URL=http://localhost:3000
