# Browser-visible variables. Set these in Vercel for Production, Preview, and Development.
# VITE_API_URL must be the public HTTPS origin of the API, without a trailing /api.
VITE_API_URL=http://localhost:3000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional application integration settings
VITE_APP_ID=
VITE_APP_BASE_URL=http://localhost:5173
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_SENTRY=false
