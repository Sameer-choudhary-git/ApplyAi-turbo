{
  "name": "engibuddy",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "playwright": "^1.61.1"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.engibuddy.app",
    "productName": "EngiBuddy",
    "asar": true,
    "protocols": {
      "name": "EngiBuddy Protocol",
      "schemes": [
        "engibuddy"
      ]
    },
    "extraMetadata": {
      "env": {
        "API_ENDPOINT": "",
        "ENCRYPTION_KEY": ""
      }
    }
  }
}
