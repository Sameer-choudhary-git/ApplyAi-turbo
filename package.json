{
  "name": "ApplyAi-turborepo",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",

    "generate": "turbo run generate",

    "build": "turbo run build",

    "lint": "turbo run lint",

    "check-types": "turbo run check-types",

    "check-all": "turbo run generate build lint check-types",

    "test": "turbo run test",

    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "jiti": "^2.7.0",
    "prettier": "^3.7.4",
    "turbo": "^2.9.4",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1026.0",
    "playwright": "^1.59.1"
  }
}
